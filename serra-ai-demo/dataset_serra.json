  "5_llm_orchestrator_mapping_table": [
    {
      "rule_id": "RULE_01_HUMIDITY_TIPBURN",
      "if_condition": "SENS_RH_AIR_PCT > 75.0 OR CV_TIPBURN_RISK > 0.30",
      "diagnosis": "Rischio muffa o necrosi marginale (Tipburn) per scarsa traspirazione",
      "solver_override": { "rh_max_pct": 62.0, "vent_min_m3_h": 1500.0 }
    },
    {
      "rule_id": "RULE_02_HEAT_WILTING",
      "if_condition": "SENS_T_AIR_C > 25.0 OR CV_WILTING_SCORE > 0.25",
      "diagnosis": "Stress termico o appassimento fogliare",
      "solver_override": { "temp_target_offset_c": -2.0, "led_max_power_w": 20000.0 }
    },
    {
      "rule_id": "RULE_03_NUTRIENT_CHLOROSIS",
      "if_condition": "CV_GREENNESS_INDEX < 0.60",
      "diagnosis": "Carenza clorofilliana / nutrienti",
      "solver_override": { "ec_setpoint_offset_ms_cm": 0.2, "ph_setpoint": 5.8 }
    },
    {
      "rule_id": "RULE_04_ENERGY_PRICE_SPIKE",
      "if_condition": "pun_eur_kwh > 0.17 AND pvgis_power_w == 0",
      "diagnosis": "Fascia serale ad alto costo elettrico senza fotovoltaico",
      "solver_override": { "prefer_dark_window_hours": [18, 19, 20, 21] }
    }
  ],

